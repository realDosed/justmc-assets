{
  "name": "@justmc/data",
  "version": "1.0.5",
  "description": "JustMC data",
  "author": "rqbik",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "build": "rollup --bundleConfigAsCjs --config rollup.config.ts --configPlugin typescript",
    "clean": "rimraf .cache",
    "create:cache": "ts-node scripts/create-cache",
    "create:icons": "ts-node scripts/create-icons",
    "create:index": "ts-node scripts/create-index",
    "extract:events": "ts-node scripts/extract-events",
    "extract:game-values": "ts-node scripts/extract-game-values",
    "extract:actions": "ts-node scripts/extract-actions",
    "extract": "yarn run extract:events && yarn run extract:game-values && yarn run extract:actions",
    "update": "yarn run create:cache && yarn run extract",
    "generate": "yarn run update && yarn run create:index && yarn run build"
  },
  "files": [
    "dist",
    "data"
  ],
  "devDependencies": {
    "@gitbeaker/node": "^35.8.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "24",
    "@types/node-fetch": "^2.6.2",
    "canvas": "^3.2.3",
    "chalk": "^4.1.2",
    "dotenv": "^16.0.3",
    "node-fetch": "^2.7.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.64.7",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "justcode",
    "justmc",
    "minecraft",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "node": "24.22.0",
    "yarn": "1.22.22"
  }
}
